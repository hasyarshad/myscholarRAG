# docker build does not read .gitignore, so everything the image doesn't need is
# listed here. The image installs its own dependencies from pyproject.toml.

# Virtual environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node: the API image contains no JavaScript
node_modules/
web/
.next/

# Source documents and the built index: the container reads its corpus from Postgres
papers/
data/
artifacts/
models/
.docling_cache/

# Repository files the image doesn't use
.git/
.gitignore
.github/
results/
tests/

# Secrets must never enter the build context: any build step can read them, and
# they can end up in an image layer.
.env
.env.*
!.env.example

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
