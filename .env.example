# myScholar-rag configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
#   cp .env.example .env
#
# Settings are nested: MYSCHOLAR_<GROUP>__<FIELD>. Everything here has a
# working default in src/myscholar/config.py, so an empty .env runs the local
# development stack. Only the deployment section needs secrets.

# ---------------------------------------------------------------------------
# Local development (this machine: 2x RTX 5090, rootless Postgres, Ollama)
# ---------------------------------------------------------------------------

MYSCHOLAR_LLM__PROVIDER=ollama
MYSCHOLAR_LLM__BASE_URL=http://localhost:11434
MYSCHOLAR_LLM__GENERATOR_MODEL=qwen3:14b
MYSCHOLAR_LLM__UTILITY_MODEL=qwen3:4b-instruct

MYSCHOLAR_EMBEDDING__PROVIDER=torch
MYSCHOLAR_EMBEDDING__DEVICE=cuda:0

MYSCHOLAR_DATABASE__URL=postgresql+asyncpg://myscholar:myscholar@localhost:5433/myscholar

# ---------------------------------------------------------------------------
# Production (Google Cloud Run: CPU only, scale to zero)
# ---------------------------------------------------------------------------
# Set these as Cloud Run environment variables and secrets, not here. Two
# differences matter: the embedder becomes the ONNX graph, and generation moves
# to a hosted API because nobody serves a 14B model on two cores.
#
# The ONNX export is the *float32* one. int8 is a quarter the size and agrees
# with PyTorch at only 0.9888, which is enough to reorder near neighbours;
# float32 agrees at 1.00000 and returns the same retrieval metrics as the GPU,
# so the index built here is served there unchanged.
#
# MYSCHOLAR_EMBEDDING__PROVIDER=onnx
# MYSCHOLAR_EMBEDDING__ONNX_PATH=/app/artifacts/embedder-onnx
# MYSCHOLAR_DATABASE__MIGRATE_ON_STARTUP=false

# --- Generation: the hosted model -------------------------------------------
# Google AI Studio. Free, no card, and the only free tier measured to run this
# whole pipeline — see docker/Dockerfile for why the alternatives were dropped.
# Key: https://aistudio.google.com/apikey
#
# `flash-lite` for both roles, pinned rather than `-latest` so the behaviour the
# tests pin cannot change underneath them. Measured: 0.87s per call, 3.3s per
# question end to end, against 11.6s for the local pair.
#
# SEED is deliberately empty. A fixed seed makes evaluation runs comparable, but
# Google rejects unknown parameters outright — `Unknown name "seed"` — instead of
# ignoring them, so it has to be switched off here.
#
# MYSCHOLAR_LLM__PROVIDER=openai_compatible
# MYSCHOLAR_LLM__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MYSCHOLAR_LLM__GENERATOR_MODEL=gemini-3.5-flash-lite
# MYSCHOLAR_LLM__UTILITY_MODEL=gemini-3.5-flash-lite
# MYSCHOLAR_LLM__SEED=

# The key for the hosted provider selected above.
MYSCHOLAR_LLM__API_KEY=

# --- Supabase: the hosted Postgres holding the index ------------------------
# Dashboard -> Project Settings -> Database -> Connection string -> URI.
#
# Two things that will bite:
#   1. Use the *session pooler* (port 5432) or the transaction pooler (6543).
#      asyncpg needs the session pooler for prepared statements; on the
#      transaction pooler add ?prepared_statement_cache_size=0
#   2. Replace `postgresql://` with `postgresql+asyncpg://` — SQLAlchemy picks
#      its driver from the scheme, and the plain form loads psycopg.
#
# MYSCHOLAR_DATABASE__URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Only needed by the loader that pushes the local index up. Not read by the app.
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Cloud Run: the API container ------------------------------------
# Free tier: 2M requests, 360k GB-seconds and 180k vCPU-seconds a month, with
# scale to zero. A portfolio assistant does not come close. Read by the deploy
# script only; the running service gets its config from Cloud Run itself.
# Set GCP_REGION to the same continent as your Supabase project — a question
# makes several database round trips, so a cross-continent hop is felt on every
# answer. `make deploy` warns if the two look mismatched.
#   ca-central-1 (Supabase) -> northamerica-northeast1  (Montreal)
#   eu-west-2    (Supabase) -> europe-west2             (London)
GCP_PROJECT_ID=
GCP_REGION=northamerica-northeast1
GCP_SERVICE=myscholar-api

# Two service accounts, both created by `make deploy` if absent. Separate on
# purpose: the runtime identity holds nothing but read access to the three
# secrets, and the build identity never runs the service. Projects created from
# 2025 onward have no legacy Cloud Build account, so the build one is required
# rather than a nicety — without it `gcloud builds submit` fails
# PERMISSION_DENIED even for a project owner, and creates no build to inspect.
# GCP_RUNTIME_SA=myscholar-run@<project>.iam.gserviceaccount.com
# GCP_BUILD_SA=myscholar-build@<project>.iam.gserviceaccount.com

# --- GitHub: pushing this repo, and the website that embeds the widget ------
# Fine-grained token with Contents: read/write on the two repos.
# https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
GITHUB_USERNAME=hasyarshad
GITHUB_RAG_REPO=myScholar-rag
GITHUB_SITE_REPO=personal-website

# --- The public API, and the shared secret guarding it ----------------------
# CORS is a browser-only control and stops nothing from curl. The real gate is
# this secret, injected by the Next.js route handler that proxies the backend.
# Generate with: openssl rand -hex 32
MYSCHOLAR_API__SHARED_SECRET=
MYSCHOLAR_API__ALLOWED_ORIGINS=["https://haseeb-arshad.me","https://www.haseeb-arshad.me","http://localhost:3000"]

# --- Sentry: error tracking, free for a year in the student pack ------------
SENTRY_DSN=
