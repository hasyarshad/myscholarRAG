# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# Nested settings use a double underscore:
#   MYSCHOLAR_LLM__PROVIDER  ->  settings.llm.provider

# --- Language model -------------------------------------------------------
# ollama = local GPU (development) | groq = hosted free tier (production)
# fake   = scripted responses, no inference at all (tests, Phase 0)
MYSCHOLAR_LLM__PROVIDER=fake
MYSCHOLAR_LLM__GENERATOR_MODEL=qwen3:14b
MYSCHOLAR_LLM__UTILITY_MODEL=qwen3:4b-instruct
MYSCHOLAR_LLM__BASE_URL=http://localhost:11434
# Only needed when provider=groq. Get one free at https://console.groq.com
# MYSCHOLAR_LLM__API_KEY=

# --- Embeddings -----------------------------------------------------------
# torch = GPU at ingest | onnx = CPU in production | hash = deterministic fake
MYSCHOLAR_EMBEDDING__PROVIDER=hash
MYSCHOLAR_EMBEDDING__MODEL_ID=BAAI/bge-base-en-v1.5
MYSCHOLAR_EMBEDDING__DIM=768

# --- Reranking ------------------------------------------------------------
MYSCHOLAR_RERANKER__PROVIDER=torch
MYSCHOLAR_RERANKER__MODEL_ID=BAAI/bge-reranker-base
# GPU 0 holds the Ollama models; the reranker goes on the second card.
MYSCHOLAR_RERANKER__DEVICE=cuda:1

# --- Database -------------------------------------------------------------
# Local Postgres runs as a user process via `make db-setup` (conda-provided
# binary, no root, no Docker). It listens on 127.0.0.1:5433 and trusts local
# connections, so no password is needed — the cluster is owned by your user and
# file permissions are the actual boundary.
#
# Replace $USER with your username, or run ./scripts/db.sh setup to be told it.
MYSCHOLAR_DATABASE__URL=postgresql+asyncpg://$USER@127.0.0.1:5433/myscholar
#
# In production this points at Supabase instead. Same engine, same SQL:
# MYSCHOLAR_DATABASE__URL=postgresql+asyncpg://postgres:...@db.xxx.supabase.co:5432/postgres

# --- Retrieval tuning -----------------------------------------------------
MYSCHOLAR_RETRIEVAL__TOP_K=50
MYSCHOLAR_RETRIEVAL__RERANK_K=8
MYSCHOLAR_RETRIEVAL__WINDOW=2
MYSCHOLAR_RETRIEVAL__DENSE_WEIGHT=1.0
MYSCHOLAR_RETRIEVAL__LEXICAL_WEIGHT=1.0

# --- Logging --------------------------------------------------------------
MYSCHOLAR_LOG_LEVEL=INFO

# --- API ------------------------------------------------------------------
# Browser origins permitted to call the API. Exact origins, never a wildcard.
# Several localhost ports are listed by default because a dev server lands
# wherever the port is free — a mismatch here fails only in the browser, with
# the API perfectly healthy and every test passing.
#
# CORS is a browser-only control and stops nothing from curl. The real gate in
# production is the shared secret the Next.js proxy injects.
# MYSCHOLAR_API__ALLOWED_ORIGINS=["http://localhost:3000","https://haseeb-arshad.me"]
