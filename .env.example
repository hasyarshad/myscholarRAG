# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# Nested settings use a double underscore:
#   MYSCHOLAR_LLM__PROVIDER  ->  settings.llm.provider

# --- Language model -------------------------------------------------------
# ollama = local GPU (development) | groq = hosted free tier (production)
# fake   = scripted responses, no inference at all (tests, Phase 0)
MYSCHOLAR_LLM__PROVIDER=fake
MYSCHOLAR_LLM__GENERATOR_MODEL=qwen3:14b
MYSCHOLAR_LLM__UTILITY_MODEL=qwen3:4b
MYSCHOLAR_LLM__BASE_URL=http://localhost:11434
# Only needed when provider=groq. Get one free at https://console.groq.com
# MYSCHOLAR_LLM__API_KEY=

# --- Embeddings -----------------------------------------------------------
# torch = GPU at ingest | onnx = CPU in production | hash = deterministic fake
MYSCHOLAR_EMBEDDING__PROVIDER=hash
MYSCHOLAR_EMBEDDING__MODEL_ID=BAAI/bge-base-en-v1.5
MYSCHOLAR_EMBEDDING__DIM=768

# --- Reranking ------------------------------------------------------------
MYSCHOLAR_RERANKER__PROVIDER=noop
MYSCHOLAR_RERANKER__MODEL_ID=BAAI/bge-reranker-base

# --- Database -------------------------------------------------------------
# Port 5433 avoids clashing with any Postgres already on the host.
MYSCHOLAR_DATABASE__URL=postgresql+asyncpg://myscholar:myscholar@localhost:5433/myscholar

# --- Retrieval tuning -----------------------------------------------------
MYSCHOLAR_RETRIEVAL__TOP_K=50
MYSCHOLAR_RETRIEVAL__RERANK_K=8
MYSCHOLAR_RETRIEVAL__WINDOW=2

# --- Logging --------------------------------------------------------------
MYSCHOLAR_LOG_LEVEL=INFO
