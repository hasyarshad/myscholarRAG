# Copy to `.env` and fill in: cp .env.example .env
#
# Settings are nested as MYSCHOLAR_<GROUP>__<FIELD>. Every field has a default in
# src/myscholar/config.py, and with no .env at all the app runs on fake components.

# --- Local development: Ollama, a GPU embedder and local Postgres ------------

MYSCHOLAR_LLM__PROVIDER=ollama
MYSCHOLAR_LLM__BASE_URL=http://localhost:11434
MYSCHOLAR_LLM__GENERATOR_MODEL=qwen3:14b
MYSCHOLAR_LLM__UTILITY_MODEL=qwen3:4b-instruct

MYSCHOLAR_EMBEDDING__PROVIDER=torch
MYSCHOLAR_EMBEDDING__DEVICE=cuda:0

MYSCHOLAR_DATABASE__URL=postgresql+asyncpg://myscholar:myscholar@localhost:5433/myscholar

# --- Production: Cloud Run, CPU only ------------------------------------------
# Set these on the Cloud Run service, not here. Use the float32 ONNX export: it
# matches PyTorch at cosine 1.00000, while int8 (0.9888) reorders near neighbours.
#
# MYSCHOLAR_EMBEDDING__PROVIDER=onnx
# MYSCHOLAR_EMBEDDING__ONNX_PATH=/app/artifacts/embedder-onnx
# MYSCHOLAR_DATABASE__MIGRATE_ON_STARTUP=false

# Hosted generation through Google AI Studio's OpenAI-compatible endpoint.
# Key: https://aistudio.google.com/apikey
# SEED must be empty: the endpoint rejects unknown parameters ("Unknown name seed").
#
# MYSCHOLAR_LLM__PROVIDER=openai_compatible
# MYSCHOLAR_LLM__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MYSCHOLAR_LLM__GENERATOR_MODEL=gemini-3.5-flash-lite
# MYSCHOLAR_LLM__UTILITY_MODEL=gemini-3.5-flash-lite
# MYSCHOLAR_LLM__SEED=
MYSCHOLAR_LLM__API_KEY=

# --- Supabase: hosted Postgres for the index ----------------------------------
# Use the session pooler (port 5432); asyncpg needs it for prepared statements.
# On the transaction pooler (6543) add ?prepared_statement_cache_size=0.
# The scheme must be postgresql+asyncpg:// or SQLAlchemy loads psycopg instead.
#
# MYSCHOLAR_DATABASE__URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Read by scripts/supabase_setup.sh and scripts/push_index.sh.
SUPABASE_DB_URL=

# --- Cloud Run deployment (read by scripts/deploy_cloudrun.sh) ----------------
# Put the service in the same region as the database: each answer makes several
# round trips to it. `make deploy` warns when the two look mismatched.
#   Supabase ca-central-1 -> northamerica-northeast1
#   Supabase eu-west-2    -> europe-west2
GCP_PROJECT_ID=
GCP_REGION=northamerica-northeast1
GCP_SERVICE=myscholar-api

# Created by `make deploy` if absent. The runtime account can only read the
# service's secrets; the build account is required on projects created since 2025.
# GCP_RUNTIME_SA=myscholar-run@<project>.iam.gserviceaccount.com
# GCP_BUILD_SA=myscholar-build@<project>.iam.gserviceaccount.com

# --- API access ---------------------------------------------------------------
# The shared secret the web proxy sends with every request. CORS only restricts
# browsers; this is what restricts everything else. Generate: openssl rand -hex 32
MYSCHOLAR_API__SHARED_SECRET=
MYSCHOLAR_API__ALLOWED_ORIGINS=["http://localhost:3000"]
