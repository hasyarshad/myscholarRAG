# Source documents — copyright-bearing publisher PDFs, never committed
papers/
data/
!data/.gitkeep
# Curated bibliographic metadata is hand-corrected human work, not a build
# artifact, and re-deriving it would mean redoing the review. Keep it.
!data/metadata.yaml

# Secrets
.env
.env.*
# The template is the one that must be committed — it is the documentation for
# every secret the project needs, and `.env.*` would otherwise swallow it.
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Models and build artifacts
models/
*.onnx
artifacts/
.docling_cache/

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Screenshots dropped into the repo root while reporting a bug
Screenshot*.png

# Detached run logs
logs/

# Working notes kept locally: design journals, audits, session handovers and the
# generated PDFs of them. The README carries what a reader of this repository
# needs; these are for the author.
docs/
CHANGELOG.md

# The toolchain that renders those notes to PDF, including its node_modules.
scripts/pdf/

# Superseded measurement runs. `results/` holds the numbers the README cites and
# the fixture the rubric tests read; intermediate runs are not part of that.
results/generation_superseded.*
