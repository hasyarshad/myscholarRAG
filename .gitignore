# Source documents — copyright-bearing publisher PDFs, never committed
papers/
data/
!data/.gitkeep
# Curated bibliographic metadata is hand-corrected human work, not a build
# artifact, and re-deriving it would mean redoing the review. Keep it.
!data/metadata.yaml

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Models and build artifacts
models/
*.onnx
artifacts/
.docling_cache/

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Screenshots dropped into the repo root while reporting a bug
Screenshot*.png
